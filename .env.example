# Edge Desk configuration. Copy to .env (gitignored). Everything is optional.
# The app needs no keys: all market data comes from public, unauthenticated endpoints.

# Desk data source: live (the recorder's log, default) | synthetic (seeded demo market) | replay
EDGE_SOURCE=live
# Speed-up for the synthetic/replay demo sources (data seconds per wall second)
EDGE_SPEED=30

# KumoRFM / NVIDIA Kumo Relational (experimental model, off by default).
# Only used when this is set AND the model is switched on in Settings. See README.
KUMO_API_KEY=
# kumoai (legacy KumoRFM SDK) | sdm (NVIDIA structured-data-models client)
KUMO_BACKEND=kumoai
# For KUMO_BACKEND=sdm: the Kumo Relational endpoint (self-hosted NIM or a gateway)
KUMO_URL=
